{
	"name": "iconnectivity",
	"version": "0.15.2",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"check:runtime": "node scripts/check-runtime.mjs",
		"format": "prettier -w .",
		"package": "yarn build && companion-module-build --output pkg/iconnectivity-interfaces-$npm_package_version",
		"package:verify": "node scripts/verify-package.mjs",
		"release:check": "yarn test && yarn lint && yarn package && yarn package:verify",
		"prebuild": "yarn check:runtime",
		"build": "yarn check:runtime && rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "yarn check:runtime && run lint:raw .",
		"test": "yarn build && node --test tests/*.test.mjs"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-iconnectivity-interfaces.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "2.0.4",
		"@julusian/midi": "^3.6.1"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^22.19.17",
		"eslint": "^9.39.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.17.0"
}
